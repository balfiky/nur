__pycache__/
*.py[cod]
*$py.class
*.so
.env
.venv/
venv/
*.egg-info/
dist/
build/
*.db
.pytest_cache/
.mypy_cache/
.ruff_cache/
.claude/
output/
qa-report/

# Persisted user/session data — NEVER commit
data/
*.session.json
runtime_config.local.yaml

# Eval reports — raw per-run/per-scenario artifacts stay local.
# Only the aggregated summary is tracked for the paper.
# (Rule: you can only un-ignore a path whose parent directory isn't
# itself ignored — so we ignore contents, not the directory.)
reports/*
!reports/ablation/
reports/ablation/*
!reports/ablation/summary.json
